      "html",
      "",
      "<div class=\"cms-block cms-block-team\" data-count=\"2\"><div class=\"cms-team-grid\"><div class=\"cms-person\"><img class=\"cms-person-photo\" src=\"media/trades-team-1.png\" alt=\"\" loading=\"lazy\" data-field=\"person1_photo\"><h3 class=\"cms-person-name\" data-field=\"person1_name\">Sean Halloran</h3><p class=\"cms-person-role\" data-field=\"person1_role\">Owner, plumber</p><p class=\"cms-person-bio\" data-field=\"person1_bio\">Took over from his father in 2009. Does the quoting and most of the boiler work.</p></div><div class=\"cms-person\"><img class=\"cms-person-photo\" src=\"media/trades-team-2.png\" alt=\"\" loading=\"lazy\" data-field=\"person2_photo\"><h3 class=\"cms-person-name\" data-field=\"person2_name\">Ash Berger</h3><p class=\"cms-person-role\" data-field=\"person2_role\">Heating engineer</p><p class=\"cms-person-bio\" data-field=\"person2_bio\">Third-year apprentice turned engineer. Knows more about heat pumps than the rest of us.</p></div></div></div>",
      {}
    ],
    [
      "html",
      "",
      "<div class=\"cms-block cms-block-timeline\" data-style=\"vertical\"><ol class=\"cms-timeline cms-timeline-vertical\"><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step1_when\">You ring</span><div class=\"cms-timeline-body\"><h3 data-field=\"step1_title\">Somebody picks up</h3><p data-field=\"step1_text\">If it is out of hours you get a call back within the hour, not the next morning.</p></div></li><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step2_when\">We look</span><div class=\"cms-timeline-body\"><h3 data-field=\"step2_title\">A price, in writing</h3><p data-field=\"step2_text\">For anything bigger than a tap we come out first, free, and put the price in an email.</p></div></li><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step3_when\">We do it</span><div class=\"cms-timeline-body\"><h3 data-field=\"step3_title\">Same person, tidy finish</h3><p data-field=\"step3_text\">Dust sheets down, everything taken away, and the old parts left for you to see.</p></div></li></ol></div>",
      {}
    ]
  ]
