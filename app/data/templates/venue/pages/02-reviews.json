      "html",
      "",
      "<div class=\"cms-block cms-block-timeline\" data-style=\"vertical\"><ol class=\"cms-timeline cms-timeline-vertical\"><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step1_when\">First</span><div class=\"cms-timeline-body\"><h3 data-field=\"step1_title\">You come and see it</h3><p data-field=\"step1_text\">Wednesdays mostly. Bring whoever is paying and whoever will worry.</p></div></li><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step2_when\">Then</span><div class=\"cms-timeline-body\"><h3 data-field=\"step2_title\">We hold the date</h3><p data-field=\"step2_text\">Two weeks, free, while you think. A deposit fixes it after that.</p></div></li><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step3_when\">Nearer</span><div class=\"cms-timeline-body\"><h3 data-field=\"step3_title\">The details</h3><p data-field=\"step3_text\">Six weeks out we sit down with the caterer and go through the day hour by hour.</p></div></li><li class=\"cms-timeline-item\"><span class=\"cms-timeline-when\" data-field=\"step4_when\">The day</span><div class=\"cms-timeline-body\"><h3 data-field=\"step4_title\">Someone is here</h3><p data-field=\"step4_text\">From setup to the last taxi. Not to run your wedding — to deal with whatever the building does.</p></div></li></ol></div>",
