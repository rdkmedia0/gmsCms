# Copy to .env and fill in what you need — or skip the file entirely and
# put the values straight into docker-compose.yml, or set nothing at all
# and configure everything in the admin screens after first run.
#
# Every value here is read ONCE, on first boot, and copied into the site's
# own database (secrets encrypted). After that the admin screens are the
# authority and changing a value here does nothing — so a stale entry
# cannot quietly override what you have since set in the app.

# --- signing in -------------------------------------------------------
# Your Google address. With the two client values below, password sign-in
# switches itself off: there is a safer way in, so the password stops
# being a way in.
# What you sign in as. Blank means "admin". Read only on the first run.
ADMIN_USERNAME=
ADMIN_GOOGLE_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank and a password is generated on first run, shown in the
# container log and saved to data/initial-admin-password.txt
ADMIN_PASSWORD=
# Username/password sign-in: blank = decide in the admin screens (starts
# on), 1 = force on, 0 = force off. Applied on every restart. 0 is refused
# unless Google sign-in can take over (client id, secret, and an admin with
# a linked Google address), and while it is off the login page can still
# let the password back in for an hour if Google stops responding.
PASSWORD_LOGIN=

# --- how it is reached -------------------------------------------------
# The port on the HOST. 443 if this container is serving HTTPS itself,
# 127.0.0.1:5000 if a proxy on this same machine is in front of it.
WEB_PORT=

# Serving HTTPS with no proxy in front: paths INSIDE the container to a
# certificate and its key (mount them in — see docker-compose.yml). Both
# or neither; the app refuses to start on half a pair rather than quietly
# serving plain HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Who may say what the original request looked like. Blank = auto:
# X-Forwarded-* is believed from a private or loopback peer and stripped
# from anyone else. "always" if your proxy reaches this from a public
# address, "never" to trust nothing.
TRUST_PROXY=

# Normally leave blank: the session cookie is marked Secure automatically
# on requests that arrive over https, however the TLS was terminated, and
# http://localhost:5000 still works. 1 pins it on for every request,
# including plain http — which locks you out of a site you reach over
# http.
FORCE_SECURE_COOKIES=

# --- taking payments --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- bookings ---------------------------------------------------------
CALCOM_API_KEY=

# --- sending email ----------------------------------------------------
# Gmail needs an App Password, not your normal one.
# Host/port default to smtp.gmail.com:587 when blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- web address ------------------------------------------------------
# Normally unnecessary: the site learns the address it is reached on the
# first time you sign in. Set it only to override that.
SITE_PUBLIC_URL=

# --- where secrets are encrypted --------------------------------------
# Optional. By default the key that decrypts your saved API keys sits in
# data/ next to the database, so a copied volume carries both halves. Move
# the contents of data/.encryption_key here and delete the file to separate
# them. An invalid value stops the site rather than corrupting anything.
ENCRYPTION_KEY=

# --- AI assistant (optional) ------------------------------------------
OPEN_WEBUI_URL=
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_MODEL=
OPEN_WEBUI_IMAGE_MODEL=
OPEN_WEBUI_VIDEO_MODEL=
